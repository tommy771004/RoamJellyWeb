# ===== AI =====
OPENROUTER_API_KEY="sk-or-v1-..."  # Vercel 後端使用
VITE_OPENROUTER_API_KEY=""         # 如果你想讓前端直接呼叫（不建議）

# ===== Geocoding API Keys (Optional, for precise geocoding fallback) =====
GEOAPIFY_API_KEY=""
LOCATIONIQ_API_KEY=""

# ===== Database =====
DATABASE_URL="postgres://..."      # 部署必填，建議使用 Neon.tech 無料 DB

# ===== Cache (Optional) =====
# REDIS_URL=""                     # 若無 Redis，會自動 fallback 到記憶體

# ===== Auth =====
JWT_SECRET="RANDOM_STRING_HERE"    # 部署必填
JWT_EXPIRES_IN="12h"
AUTH_REQUIRED="true"
ENABLE_DEV_TOKEN_ENDPOINT="false"  # 正式環境建議關閉

# ===== Runtime =====
NODE_ENV="production"
PORT="3000"
# 預設停用；僅在需要注入示範資料時才設為 true（與 docs 一致）
SEED_DEMO_DATA="false"
# 逗號分隔的允許來源（精確比對，因 credentials=true 不支援 "*"）。
# 正式網域請列在此；非 production 會自動加入 localhost。
CORS_ALLOWED_ORIGINS="https://roam-jelly-web.vercel.app"
