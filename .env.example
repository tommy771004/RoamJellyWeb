# ===== AI =====
OPENROUTER_API_KEY="sk-or-v1-..."  # Vercel 後端使用
VITE_OPENROUTER_API_KEY=""         # 如果你想讓前端直接呼叫（不建議）

# ===== Geocoding API Keys (Optional, for precise geocoding fallback) =====
GEOAPIFY_API_KEY=""
LOCATIONIQ_API_KEY=""

# ===== Database =====
DATABASE_URL="postgres://..."      # 部署必填，建議使用 Neon.tech 無料 DB

# ===== Cache (Optional) =====
# REDIS_URL=""                     # 若無 Redis，會自動 fallback 到記憶體

# ===== Auth =====
JWT_SECRET="RANDOM_STRING_HERE"    # 部署必填
JWT_EXPIRES_IN="15m"
AUTH_DATA_ENCRYPTION_KEY="ANOTHER_RANDOM_STRING_HERE" # 加密暫存的 Provider PKCE verifier
AUTH_REQUIRED="true"
ENABLE_DEV_TOKEN_ENDPOINT="false"  # 正式環境建議關閉
AUTH_WEB_BASE_URL="https://roam-jelly-web.vercel.app"
AUTH_EMAIL_FROM="RoamJelly <auth@example.com>"
RESEND_API_KEY=""

# ===== Social Login（Provider Secret 僅限後端） =====
AUTH_PUBLIC_BASE_URL="https://api.example.com"
AUTH_ALLOWED_APP_REDIRECT_URIS="https://roam-jelly-web.vercel.app/auth/callback"
SOCIAL_AUTH_CALLBACK_ENABLED="false" # 填妥 Provider 設定並完成 migration 後才開啟

APPLE_CLIENT_ID=""
APPLE_REDIRECT_URI="https://api.example.com/api/auth/social/callback/apple"
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY_SECRET_REF="env://APPLE_PRIVATE_KEY_VALUE" # 亦可用 file:///run/secrets/apple.p8

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET_SECRET_REF="env://GOOGLE_CLIENT_SECRET_VALUE"
GOOGLE_REDIRECT_URI="https://api.example.com/api/auth/social/callback/google"

LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET_SECRET_REF="env://LINE_CHANNEL_SECRET_VALUE"
LINE_REDIRECT_URI="https://api.example.com/api/auth/social/callback/line"

# Frontend 僅放公開 redirect URI，不可放 Provider Secret。
# 登入圖示由後端依上述各 Provider 必要參數是否完整自動判斷。
VITE_AUTH_CALLBACK_URI="https://roam-jelly-web.vercel.app/auth/callback"

# ===== Runtime =====
NODE_ENV="production"
PORT="3000"
# 預設停用；僅在需要注入示範資料時才設為 true（與 docs 一致）
SEED_DEMO_DATA="false"
# 逗號分隔的允許來源（精確比對，因 credentials=true 不支援 "*"）。
# 正式網域請列在此；非 production 會自動加入 localhost。
CORS_ALLOWED_ORIGINS="https://roam-jelly-web.vercel.app"
