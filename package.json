{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && esbuild server.ts --platform=node --target=node18 --bundle --format=cjs --out-extension:.js=.cjs --outdir=dist --external:pg-native --external:bufferutil --external:utf-8-validate --external:playwright --external:@sparticuz/chromium --external:playwright-core",
    "vercel-build": "vite build && esbuild server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=api/_server.cjs --external:pg-native --external:bufferutil --external:utf-8-validate --external:playwright --external:@sparticuz/chromium --external:playwright-core",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "postinstall": "npx -y playwright install chromium",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "sync:travel-guide": "node scripts/sync-travel-guide.mjs",
    "test:integration:staging": "tsx scripts/staging-integration-test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@sparticuz/chromium": "^148.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.2",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
